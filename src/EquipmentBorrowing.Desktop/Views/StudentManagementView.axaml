<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:dom="using:EquipmentBorrowing.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentManagementView"
             x:DataType="vm:StudentManagementViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="20">
            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Student Management &amp; Eligibility" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Register students (UC-12), update contact info (UC-13), and manage borrowing eligibility permissions (UC-14)" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search name or ID..." Width="200" VerticalAlignment="Center" />
                    <Button Command="{Binding LoadStudentsCommand}" Background="#334155" Foreground="#F8FAFC" Padding="14,8" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔍" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- FEEDBACK BANNER -->
            <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1"
                    CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#F8FAFC" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- REGISTER STUDENT PANEL (UC-12) -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Register New Student (UC-12)" FontWeight="SemiBold" FontSize="14" Foreground="#38BDF8" />
                    <Grid ColumnDefinitions="180,240,*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Student Number (Unique) *" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Full Name *" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Contact Info (Optional)" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,4" />

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewStudentNumber}" PlaceholderText="2024-0005" Margin="0,0,10,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewName}" PlaceholderText="Student Full Name" Margin="0,0,10,0" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewContactInfo}" PlaceholderText="Phone or email" Margin="0,0,10,0" />

                        <Button Grid.Row="1" Grid.Column="3"
                                Command="{Binding RegisterStudentCommand}"
                                Content="➕ Register Student"
                                Background="#0284C7" Foreground="#FFFFFF"
                                FontWeight="SemiBold" Padding="16,8" CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- EDIT STUDENT PANEL (UC-13) -->
            <Border IsVisible="{Binding IsEditing}"
                    Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Edit Student Information (UC-13 — Preserves Internal ID &amp; Borrowing History)" FontWeight="SemiBold" FontSize="14" Foreground="#FBBF24" />
                        <TextBlock Grid.Column="1" Text="Leave contact blank to clear optional contact info" FontSize="11" Foreground="#94A3B8" />
                    </Grid>
                    <Grid ColumnDefinitions="180,240,*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Student Number" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Full Name" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Contact Info" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,4" />

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EditStudentNumber}" Margin="0,0,10,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditName}" Margin="0,0,10,0" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding EditContactInfo}" Margin="0,0,10,0" />

                        <Button Grid.Row="1" Grid.Column="3"
                                Command="{Binding SaveEditCommand}"
                                Content="💾 Save"
                                Background="#2563EB" Foreground="#FFFFFF"
                                FontWeight="SemiBold" Padding="14,8" CornerRadius="6" Margin="0,0,8,0" />
                        <Button Grid.Row="1" Grid.Column="4"
                                Command="{Binding CancelEditCommand}"
                                Content="Cancel"
                                Background="#475569" Foreground="#F8FAFC"
                                Padding="12,8" CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- STUDENTS LIST WITH ELIGIBILITY TOGGLE (UC-14) -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#0F172A" Padding="16,10" CornerRadius="8,8,0,0">
                        <Grid ColumnDefinitions="160,220,*,120,160">
                            <TextBlock Grid.Column="0" Text="STUDENT #" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="1" Text="FULL NAME" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="2" Text="CONTACT" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="3" Text="ELIGIBILITY" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="4" Text="ACTIONS" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding StudentsList}"
                             SelectedItem="{Binding SelectedStudent}"
                             MaxHeight="380"
                             Background="Transparent"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dom:Student">
                                <Border Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="160,220,*,120,160">
                                        <TextBlock Grid.Column="0" Text="{Binding StudentNumber}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ContactInfo, FallbackValue='—'}" Foreground="#94A3B8" VerticalAlignment="Center" />

                                        <!-- Eligibility Badge -->
                                        <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="8,3" Background="#065F46">
                                            <TextBlock Text="{Binding EligibilityStatus}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>

                                        <!-- Action Buttons: Edit and Toggle Eligibility -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="Edit"
                                                    Command="{Binding $parent[UserControl].((vm:StudentManagementViewModel)DataContext).StartEditCommand}"
                                                    Background="#334155" Foreground="#F8FAFC"
                                                    FontSize="11" Padding="10,4" CornerRadius="4" />
                                            <Button Content="Toggle (UC-14)"
                                                    Command="{Binding $parent[UserControl].((vm:StudentManagementViewModel)DataContext).ToggleEligibilityCommand}"
                                                    Background="#475569" Foreground="#F8FAFC"
                                                    FontSize="11" Padding="10,4" CornerRadius="4" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
