<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System — Laboratory Activity 4 (PostgreSQL)"
        Width="1240" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="38" Height="38">
                        <TextBlock Text="🏛️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Campus Equipment Borrowing System" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" />
                        <TextBlock Text="Lab 4: Advanced Workflows &amp; PostgreSQL Integration" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- Database Status Badge -->
                <Border Grid.Column="2"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10"
                                 Fill="#10B981"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DatabaseStatus}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#E2E8F0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY (Sidebar + Active View) -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*">
            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="#1E293B" Padding="14,20" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Nav Section Header -->
                    <TextBlock Grid.Row="0" Text="WORKFLOW MODULES" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="10,0,0,14" LetterSpacing="1" />

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1" Spacing="6">
                        <!-- 1. Equipment Catalog (UC-01, UC-02, UC-15, UC-16) -->
                        <Button Command="{Binding NavigateToEquipmentCommand}"
                                HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#2563EB" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Equipment Catalog" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Browse, filter &amp; manage" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 2. Active Loans & Return (UC-04, UC-05) -->
                        <Button Command="{Binding NavigateToBorrowingsCommand}"
                                HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#059669" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Borrowings" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Monitor &amp; process returns" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 3. Checkout Workflows (UC-03, UC-06) -->
                        <Button Command="{Binding NavigateToCheckoutCommand}"
                                HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#7C3AED" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🛒" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Checkout &amp; Multi-Issue" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Single &amp; atomic multi-item" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 4. History & Search (UC-07, UC-08, UC-09) -->
                        <Button Command="{Binding NavigateToHistoryCommand}"
                                HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#D97706" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="History &amp; Search" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Filter, sort &amp; records" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 5. Student Management (UC-12, UC-13, UC-14) -->
                        <Button Command="{Binding NavigateToStudentsCommand}"
                                HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#0284C7" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🎓" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Student Management" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Register &amp; eligibility" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Architecture Footer Card -->
                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Architecture Clean Stack" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" />
                            <TextBlock Text="• PostgreSQL 18 &amp; Npgsql" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="• EF Core 10 (Migrations)" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="• CommunityToolkit.Mvvm" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="• Atomic Transactions (UC-06)" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN VIEW HOST -->
            <Border Grid.Column="1" Background="#0B0F19">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
